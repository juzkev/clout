# Trading Research System — copy to .env and fill in your keys

# Data providers
FRED_API_KEY=your_fred_key_here
NEWSAPI_KEY=your_newsapi_key_here

# Coinglass (crypto derivatives data)
COINGLASS_API_KEY=your_coinglass_key_here

# LLM providers (only one needed, based on LLM_PROVIDER setting)
DEEPSEEK_API_KEY=your_deepseek_key_here
CLAUDE_API_KEY=your_claude_key_here

# LLM provider: "manual" | "deepseek" | "claude"
# "manual" — saves prompt to file, asks you to paste JSON response back
LLM_PROVIDER=manual

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
